# Run npm run setup to create .env with a random secret.
BETTER_AUTH_URL=http://127.0.0.1:8765
BETTER_AUTH_SECRET=
DATABASE_PATH=./data/codey.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional path to Python, used only when exporting the authored curriculum.
CODEY_PYTHON=
# Local defaults below can remain commented. The Docker image sets its listeners.
# HOST=127.0.0.1
# PORT=8765
# Remote deployments require HTTPS for BETTER_AUTH_URL.
